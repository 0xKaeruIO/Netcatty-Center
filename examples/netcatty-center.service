[Unit]
Description=Netcatty Center
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/var/lib/netcatty-center
Environment=HOST=0.0.0.0
Environment=PORT=4780
Environment=DATA_DIR=/var/lib/netcatty-center
Environment=NCC_ADMIN_USER=admin
Environment=NCC_ADMIN_PASSWORD=change-me
ExecStart=/usr/local/bin/netcatty-center
Restart=always
RestartSec=5s

# 日志走 journald：journalctl -u netcatty-center -f
StandardOutput=journal
StandardError=journal
SyslogIdentifier=netcatty-center

[Install]
WantedBy=multi-user.target
